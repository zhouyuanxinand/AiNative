# 复制为 .env 并填写本机凭据；切勿提交真实 .env 到仓库。
# 本文件只提供无密钥配置示例，不参与运行时模型选择。

# ── 运行环境与端口 ──────────────────────────────────────
# APP_ENV: development | testing | prod（回退读 SPRING_PROFILES_ACTIVE）
APP_ENV=development
JTB_HOST=127.0.0.1
JTB_PORT=18130
# 允许的前端来源（逗号分隔或 JSON 数组字符串）
CORS_ORIGINS=["http://127.0.0.1:18130","http://localhost:18130"]

# ── 任务调度 ────────────────────────────────────────────
JTB_MAX_UPLOAD_MB=100
JTB_MAX_CONCURRENT_JOBS=2
JTB_JOB_TTL_HOURS=24
JTB_MAX_JOB_RECORDS=100

# ── 安全开关 ────────────────────────────────────────────
# 仅开发环境开启本地路径接口（submit_local / precheck_local）
JTB_ALLOW_LOCAL_PATHS=0
# 允许远程提交运行时 LLM 配置（生产环境保持 0）
JTB_ALLOW_REMOTE_LLM_CONFIG=0

# ── LLM 凭据（三选一，优先级：进程环境 > .env） ────────

# 方式 A：神州问学 SmartVision（App-Id / Api-Key / Tenant-Id）
MODEL_BASE_URL=https://sv.dcsmartvision.com/open/
MODEL_APP_ID=replace-with-app-id
MODEL_API_KEY=replace-with-api-key
MODEL_TENANT_ID=replace-with-tenant-id
MODEL_NAME=replace-with-model-name
MODEL_ID=replace-with-model-id

# 方式 B：DashScope（阿里，OpenAI 兼容，Bearer Token）
AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AI_API_KEY=replace-with-api-key
AI_MODEL=qwen-plus

# 方式 C：通用 OpenAI 兼容（JTB_LLM_*）
JTB_LLM_PROVIDER=openai_compatible
JTB_LLM_API_URL=https://sv.dcsmartvision.com/open/opi-maas/v1/chat/completions
JTB_LLM_API_KEY=replace-with-api-key
JTB_LLM_APP_ID=replace-with-app-id
JTB_LLM_MODEL=dashscope/qwen3.5-plus
JTB_LLM_MODEL_ID=5506

# 方式 D：Azure OpenAI
AZURE_OPENAI_API_KEY=replace-with-your-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── 可选：共享 .env（凭据集中托管） ────────────────────
# JTB_SHARED_ENV_FILE=/path/to/shared/.env
